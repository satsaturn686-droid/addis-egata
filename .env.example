# Database
DATABASE_URL=

# Server
PORT=10000
NODE_ENV=production

# Telegram Mini App
TELEGRAM_BOT_TOKEN=

# Telegram init-data validation
# Maximum accepted age of Telegram WebApp initData.
# Default: 24 hours
# Maximum allowed: 7 days
TELEGRAM_MAX_AUTH_AGE_SECONDS=86400

# Admin Telegram IDs
# Comma-separated Telegram user IDs
ADMIN_TELEGRAM_IDS=
